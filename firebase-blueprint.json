{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in the Insta King network",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Firebase Auth UID" },
        "username": { "type": "string", "maxLength": 30, "description": "Unique handle without @" },
        "displayName": { "type": "string", "maxLength": 60, "description": "Display name" },
        "photoURL": { "type": "string", "maxLength": 500000, "description": "Profile picture URL or base64 data" },
        "bio": { "type": "string", "maxLength": 300, "description": "Profile biography" },
        "website": { "type": "string", "maxLength": 150, "description": "Website or social link" },
        "followersCount": { "type": "number", "description": "Count of followers" },
        "followingCount": { "type": "number", "description": "Count of followed users" },
        "postsCount": { "type": "number", "description": "Count of published posts" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "username", "displayName"]
    },
    "Post": {
      "title": "Post",
      "description": "A feed post with photo or video",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique post ID" },
        "authorId": { "type": "string", "description": "Author Auth UID" },
        "authorName": { "type": "string", "maxLength": 60, "description": "Author display name" },
        "authorUsername": { "type": "string", "maxLength": 30, "description": "Author username handle" },
        "authorPhotoURL": { "type": "string", "maxLength": 500000, "description": "Author avatar URL" },
        "mediaUrl": { "type": "string", "maxLength": 2000000, "description": "Photo or video media URL / data" },
        "mediaType": { "type": "string", "enum": ["photo", "video"], "description": "Media format type" },
        "caption": { "type": "string", "maxLength": 2200, "description": "Post caption and hashtags" },
        "likesCount": { "type": "number", "description": "Number of likes" },
        "commentsCount": { "type": "number", "description": "Number of comments" },
        "aspectRatio": { "type": "string", "maxLength": 10, "description": "Aspect ratio 1:1, 4:5, 16:9" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Publication timestamp" }
      },
      "required": ["id", "authorId", "mediaUrl", "mediaType"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique comment ID" },
        "postId": { "type": "string", "description": "Post ID" },
        "authorId": { "type": "string", "description": "Author Auth UID" },
        "authorName": { "type": "string", "maxLength": 60, "description": "Author display name" },
        "authorUsername": { "type": "string", "maxLength": 30, "description": "Author username handle" },
        "authorPhotoURL": { "type": "string", "maxLength": 500000, "description": "Author avatar URL" },
        "text": { "type": "string", "maxLength": 1000, "description": "Comment message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["id", "postId", "authorId", "text"]
    },
    "Like": {
      "title": "Like",
      "description": "Like record on a post",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID who liked" },
        "postId": { "type": "string", "description": "Liked post ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["userId", "postId"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follow relationship between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Follow record ID (followerId_followingId)" },
        "followerId": { "type": "string", "description": "User UID following" },
        "followingId": { "type": "string", "description": "Target user UID being followed" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["followerId", "followingId"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct message chat thread",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Conversation ID" },
        "participants": { "type": "array", "description": "List of user UIDs in chat" },
        "participantDetails": { "type": "object", "description": "Cached names/avatars/usernames by UID" },
        "lastMessage": { "type": "string", "maxLength": 1000, "description": "Last sent message snippet" },
        "lastSenderId": { "type": "string", "description": "UID of last sender" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["id", "participants"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "A message inside a direct conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "conversationId": { "type": "string", "description": "Parent conversation ID" },
        "senderId": { "type": "string", "description": "Author UID" },
        "senderName": { "type": "string", "maxLength": 60, "description": "Sender name" },
        "senderPhotoURL": { "type": "string", "maxLength": 500000, "description": "Sender avatar" },
        "text": { "type": "string", "maxLength": 2000, "description": "Message text" },
        "mediaUrl": { "type": "string", "maxLength": 2000000, "description": "Attached media URL / image" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "none"], "description": "Media type" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Sent timestamp" }
      },
      "required": ["id", "conversationId", "senderId"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour temporary story",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Story ID" },
        "authorId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "maxLength": 60, "description": "Author name" },
        "authorUsername": { "type": "string", "maxLength": 30, "description": "Author username" },
        "authorPhotoURL": { "type": "string", "maxLength": 500000, "description": "Author avatar" },
        "mediaUrl": { "type": "string", "maxLength": 2000000, "description": "Media URL" },
        "mediaType": { "type": "string", "enum": ["photo", "video"], "description": "Type of media" },
        "caption": { "type": "string", "maxLength": 200, "description": "Story caption" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "authorId", "mediaUrl", "mediaType"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "recipientId": { "type": "string", "description": "Target user UID" },
        "senderId": { "type": "string", "description": "Trigger user UID" },
        "senderName": { "type": "string", "maxLength": 60, "description": "Trigger user name" },
        "senderUsername": { "type": "string", "maxLength": 30, "description": "Trigger user username" },
        "senderPhotoURL": { "type": "string", "maxLength": 500000, "description": "Trigger user avatar" },
        "type": { "type": "string", "enum": ["like", "comment", "follow", "direct"], "description": "Type" },
        "postId": { "type": "string", "description": "Related post ID if applicable" },
        "message": { "type": "string", "maxLength": 300, "description": "Description text" },
        "read": { "type": "boolean", "description": "Read status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["id", "recipientId", "senderId", "type"]
    },
    "Block": {
      "title": "Block",
      "description": "Block record between users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Block ID (blockerId_blocks_blockedId)" },
        "blockerId": { "type": "string", "description": "User UID who blocked" },
        "blockedId": { "type": "string", "description": "Target user UID being blocked" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["id", "blockerId", "blockedId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profile documents"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public posts collection"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments subcollection under posts"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Likes subcollection under posts"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follow relationships"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct chat conversation records"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Individual messages in a direct chat"
    },
    "/blocks/{blockId}": {
      "schema": "Block",
      "description": "Block relationships"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Public user stories"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
